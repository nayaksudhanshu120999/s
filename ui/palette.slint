                            height: 32px;
                            border-radius: 6px;
                            background: root.theme.card-bg;
                            border-width: 1px;
                            border-color: root.theme.border;
                            clip: true;
                            if root.new-bang-url == "" : Text {
                                x: 10px;
                                text: "URL with {q} (e.g. https://www.youtube.com/results?search_query={q})";
                                color: root.theme.text-muted;
                                font-size: 12px;
                                overflow: elide;
                                vertical-alignment: center;
                                height: 100%;
                            }
                            TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: 100%;
                                text <=> root.new-bang-url;
                                color: root.theme.text-primary;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }

                        Rectangle {
                            width: 105px;
                            height: 32px;
                            border-radius: 6px;
                            background: root.theme.accent;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (root.new-bang-key != "" && root.new-bang-url != "") {
                                        root.add-bang(root.new-bang-key, root.new-bang-url);
                                        root.new-bang-key = "";
                                        root.new-bang-url = "";
                                    }
                                }
                            }
                            Text {
                                text: "+ Add Bang";
                                color: #000000;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        width: 100%;

                        VerticalLayout {
                            spacing: 5px;
                            padding-right: 6px;
                            alignment: start;

                            for bang[idx] in root.bang-entries : Rectangle {
                                height: 38px;
                                border-radius: 7px;
                                background: root.theme.card-bg;
                                border-width: 1px;
                                border-color: root.theme.border;
                                clip: true;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;

                                    Text {
                                        width: 65px;
                                        text: "[" + bang.key + "]";
                                        color: root.theme.accent;
                                        font-size: 12px;
                                        font-weight: 700;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        text: bang.url;
                                        color: root.theme.text-secondary;
                                        font-size: 12px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 72px;
                                            height: 24px;
                                            border-radius: 5px;
                                            background: root.theme.surface-bg;
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.remove-bang(bang.key); }
                                            }
                                            Text {
                                                text: "Remove";
                                                color: #fda4af;
                                                font-size: 11px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
