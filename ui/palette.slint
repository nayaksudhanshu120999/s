                                            if (root.new-cmd-name != "" && root.new-cmd-target != "") {
                                                root.add-custom-command(root.new-cmd-name, root.new-cmd-target);
                                                root.new-cmd-name = "";
                                                root.new-cmd-target = "";
                                            }
                                        }
                                    }
                                    Text {
                                        text: "+ Add Command";
                                        color: #000000;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Text {
